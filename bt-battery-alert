#!/usr/bin/env python3
"""Bluetooth battery alerts and tray icons for Linux desktops.

Reads battery levels of Bluetooth devices from UPower, shows them all in one
tray icon (StatusNotifierItem: an icon and charge number per device), and
sends a low-battery notification when a device drops to the alert threshold.
"""

import argparse
import math
import os
import re
import signal
import sys
import xml.etree.ElementTree as ET
from xml.sax.saxutils import quoteattr

import dbus
import dbus.service
from dbus.mainloop.glib import DBusGMainLoop
import gi
gi.require_version("Pango", "1.0")
gi.require_version("PangoCairo", "1.0")
from gi.repository import GLib, Pango, PangoCairo

try:
    from gi.repository import GLibUnix
    unix_signal_add = GLibUnix.signal_add
except ImportError:  # PyGObject < 3.52
    unix_signal_add = GLib.unix_signal_add

APP_ID = "bt-battery-alert"
APP_NAME = "Bluetooth Battery"

UPOWER = "org.freedesktop.UPower"
UPOWER_PATH = "/org/freedesktop/UPower"
UPOWER_DEVICE = "org.freedesktop.UPower.Device"
PROPS = "org.freedesktop.DBus.Properties"
SNI = "org.kde.StatusNotifierItem"
SNW = "org.kde.StatusNotifierWatcher"
DBUSMENU = "com.canonical.dbusmenu"

# UPower device types; anything not listed is reported as "Device".
KINDS = {
    5: "Mouse", 6: "Keyboard", 7: "PDA", 8: "Phone", 9: "Media player",
    10: "Tablet", 11: "Computer", 12: "Game controller", 13: "Pen",
    14: "Touchpad", 17: "Headset", 18: "Speakers", 19: "Headphones",
    22: "Remote control", 26: "Wearable", 27: "Toy",
}
POWER_SOURCES = {1, 2, 3}  # line power, laptop battery, UPS
CHARGING_STATES = {1, 4, 5}  # charging, fully charged, pending charge
MAC_RE = re.compile(r"([0-9a-f]{2}[:_]){5}[0-9a-f]{2}", re.I)

# Hysteresis: once alerted, a device must climb this far above the threshold
# (or start charging) before it can alert again.
REARM_MARGIN = 5

# Most Bluetooth devices only report a percentage (state "unknown"), so
# charging is inferred: a rise of this many points from the lowest reading
# means charging; a drop this far from the highest reading means it stopped.
# The margin absorbs the small rebound some firmware shows after waking.
TREND_MARGIN = 3


class Device:
    def __init__(self, path, props):
        self.path = str(path)
        self.native = str(props.get("NativePath", ""))
        self.name = str(props.get("Model", "")) or "Bluetooth device"
        self.kind = KINDS.get(int(props.get("Type", 0)), "Device")
        self.percent = int(round(float(props.get("Percentage", 0))))
        self.state = int(props.get("State", 0))
        self.present = bool(props.get("IsPresent", True))
        self.power_supply = bool(props.get("PowerSupply", False))
        self.type = int(props.get("Type", 0))
        # Serial is the MAC for Bluetooth devices; stable across reconnects.
        self.key = str(props.get("Serial", "")) or self.native or self.path
        self.inferred_charging = False

    @property
    def state_known(self):
        return self.state != 0

    @property
    def charging(self):
        return self.state in CHARGING_STATES or self.inferred_charging

    def is_bluetooth(self):
        return "/org/bluez/" in self.native or bool(MAC_RE.search(self.native))

    def is_peripheral(self):
        return not self.power_supply and self.type not in POWER_SOURCES

    def summary(self):
        status = " (charging)" if self.charging else ""
        return f"{self.name}: {self.percent}%{status}"


# --------------------------------------------------------------------------
# Icon rendering


# Soft GNOME (Adwaita) palette tones, so warnings sit well on Fedora's panel.
ORANGE = (1.0, 0.64, 0.28)  # #ffa348
RED = (0.96, 0.38, 0.32)  # #f66151
BLUE = (0.38, 0.63, 0.92)  # #62a0ea


def level_color(percent, threshold, critical, charging):
    """Tint for a device in the tray; None (white) when there is nothing to flag."""
    if charging:
        return BLUE
    if percent <= critical:
        return RED
    if percent <= threshold:
        return ORANGE
    return None


# Adwaita symbolic icon per device kind, the same ones GNOME's panel uses.
ICONS = {
    "Mouse": "input-mouse", "Touchpad": "input-touchpad", "Keyboard": "input-keyboard",
    "Headset": "audio-headset", "Headphones": "audio-headphones",
    "Speakers": "audio-speakers", "Game controller": "input-gaming", "Phone": "phone",
}
DEFAULT_ICON = "bluetooth-active"
WHITE = (1, 1, 1)


def find_icon(name):
    """Path of an Adwaita symbolic icon, or None."""
    dirs = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    for d in dirs.split(":"):
        base = os.path.join(d, "icons", "Adwaita", "symbolic")
        if not os.path.isdir(base):
            continue
        for context in os.listdir(base):
            path = os.path.join(base, context, f"{name}-symbolic.svg")
            if os.path.exists(path):
                return path
    return None


def panel_font():
    """The interface font in bold at its pixel size, as GNOME's top bar
    shows it."""
    name, scale = "Sans 10", 1.0
    try:
        from gi.repository import Gio
        settings = Gio.Settings.new("org.gnome.desktop.interface")
        name = settings.get_string("font-name") or name
        scale = settings.get_double("text-scaling-factor") or scale
    except Exception:  # not GNOME, or schema missing
        pass
    desc = Pango.FontDescription.from_string(name)
    size = desc.get_size() / Pango.SCALE
    if not desc.get_size_is_absolute():
        size *= 96 / 72  # points to pixels
    desc.set_weight(Pango.Weight.BOLD)
    desc.set_absolute_size(size * scale * Pango.SCALE)
    return desc


def hex_color(rgb):
    return "#" + "".join(f"{round(c * 255):02x}" for c in rgb)


def icon_svg(name, x, size, rgb):
    """An Adwaita symbolic icon's shapes, recoloured and placed at (x, 0)."""
    path = find_icon(name) or find_icon(DEFAULT_ICON)
    if not path:
        return ""
    root = ET.parse(path).getroot()
    for el in root.iter():
        el.tag = el.tag.split("}")[-1]  # drop the namespace; the strip declares it
        if el.get("fill") not in (None, "none"):
            el.set("fill", hex_color(rgb))  # fill-opacity stays: it dims parts
    shapes = "".join(ET.tostring(child, encoding="unicode") for child in root)
    return f'<g transform="translate({x:g} 0) scale({size / 16:g})">{shapes}</g>'


def render_strip(height, entries):
    """Draw every device as its icon followed by its charge number, side by
    side with a faint divider between devices, `height` units tall.

    Returns SVG rather than pixels, so the shell rasterises it at the screen's
    real resolution; a bitmap gets stretched on HiDPI screens. `entries` holds
    (icon name, percent, rgb) tuples; rgb None means white."""
    h = height
    inner, gap = 0.25 * h, 0.6 * h  # icon-to-number, around dividers
    entries = entries or [(DEFAULT_ICON, None, None)]
    desc = panel_font()
    family = desc.get_family()
    px = desc.get_size() / Pango.SCALE
    layout = Pango.Layout.new(PangoCairo.FontMap.get_default().create_context())
    layout.set_font_description(desc)

    body, x = [], 0.0
    for n, (icon, percent, rgb) in enumerate(entries):
        if n:
            body.append(f'<rect x="{x + gap:g}" y="{0.25 * h:g}" width="1" '
                        f'height="{0.5 * h:g}" fill="#ffffff" fill-opacity="0.3"/>')
            x += 2 * gap + 1
        rgb = rgb or WHITE
        body.append(icon_svg(icon, x, h, rgb))
        x += h
        if percent is None:
            continue
        # Measure the digits' ink, so they sit exactly `inner` from the icon
        # and centred on its height.
        layout.set_text(str(percent), -1)
        ink = layout.get_extents()[0]
        ix, iy = ink.x / Pango.SCALE, ink.y / Pango.SCALE
        iw, ih = ink.width / Pango.SCALE, ink.height / Pango.SCALE
        baseline = layout.get_baseline() / Pango.SCALE
        body.append(
            f'<text x="{x + inner - ix:g}" y="{(h - ih) / 2 - iy + baseline:g}" '
            f'font-family={quoteattr(family)} font-weight="bold" font-size="{px:g}px" '
            f'fill="{hex_color(rgb)}">{percent}</text>')
        x += inner + iw
    width = math.ceil(max(x, 1.5 * h))  # at least 1.5:1, so the shell keeps it wide
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{h}" '
            f'viewBox="0 0 {width} {h}">{"".join(body)}</svg>')


def remove_file(path):
    try:
        os.remove(path)
    except OSError:
        pass
    return False  # one-shot when used as a GLib timeout


# --------------------------------------------------------------------------
# Tray icon (StatusNotifierItem + a minimal dbusmenu)


class Menu(dbus.service.Object):
    QUIT_ID = 1

    def __init__(self, conn, app):
        super().__init__(conn, "/MenuBar")
        self.app = app
        self.revision = 1

    def _item(self, item_id, props):
        return dbus.Struct(
            (dbus.Int32(item_id), dbus.Dictionary(props, signature="sv"),
             dbus.Array([], signature="v")),
            signature="ia{sv}av")

    def _items(self):
        items = []
        for n, dev in enumerate(self.app.sorted_devices(), start=100):
            items.append(self._item(n, {"label": f"{dev.kind} — {dev.summary()}",
                                        "enabled": False}))
        if not items:
            items.append(self._item(99, {"label": "No Bluetooth batteries", "enabled": False}))
        items.append(self._item(2, {"type": "separator"}))
        items.append(self._item(self.QUIT_ID, {"label": "Quit"}))
        return items

    def refresh(self):
        self.revision += 1
        self.LayoutUpdated(self.revision, 0)

    @dbus.service.method(DBUSMENU, in_signature="iias", out_signature="u(ia{sv}av)")
    def GetLayout(self, parent_id, depth, names):
        root = dbus.Struct(
            (dbus.Int32(0), dbus.Dictionary({"children-display": "submenu"}, signature="sv"),
             dbus.Array(self._items(), signature="v")),
            signature="ia{sv}av")
        return dbus.UInt32(self.revision), root

    @dbus.service.method(DBUSMENU, in_signature="aias", out_signature="a(ia{sv})")
    def GetGroupProperties(self, ids, names):
        found = {int(i[0]): i[1] for i in self._items()}
        return dbus.Array(
            [dbus.Struct((dbus.Int32(i), found[int(i)]), signature="ia{sv}")
             for i in ids if int(i) in found],
            signature="(ia{sv})")

    @dbus.service.method(DBUSMENU, in_signature="is", out_signature="v")
    def GetProperty(self, item_id, name):
        for i in self._items():
            if int(i[0]) == item_id and name in i[1]:
                return i[1][name]
        return ""

    @dbus.service.method(DBUSMENU, in_signature="isvu", out_signature="")
    def Event(self, item_id, event_id, data, timestamp):
        if event_id == "clicked" and item_id == self.QUIT_ID:
            GLib.idle_add(self.app.quit)

    @dbus.service.method(DBUSMENU, in_signature="a(isvu)", out_signature="ai")
    def EventGroup(self, events):
        for item_id, event_id, data, ts in events:
            self.Event(item_id, event_id, data, ts)
        return dbus.Array([], signature="i")

    @dbus.service.method(DBUSMENU, in_signature="i", out_signature="b")
    def AboutToShow(self, item_id):
        return False

    @dbus.service.method(DBUSMENU, in_signature="ai", out_signature="aiai")
    def AboutToShowGroup(self, ids):
        return dbus.Array([], signature="i"), dbus.Array([], signature="i")

    @dbus.service.signal(DBUSMENU, signature="ui")
    def LayoutUpdated(self, revision, parent):
        pass

    @dbus.service.signal(DBUSMENU, signature="a(ia{sv})a(ias)")
    def ItemsPropertiesUpdated(self, updated, removed):
        pass

    @dbus.service.method(PROPS, in_signature="ss", out_signature="v")
    def Get(self, iface, name):
        return self.GetAll(iface)[name]

    @dbus.service.method(PROPS, in_signature="s", out_signature="a{sv}")
    def GetAll(self, iface):
        return dbus.Dictionary({
            "Version": dbus.UInt32(3),
            "TextDirection": "ltr",
            "Status": "normal",
            "IconThemePath": dbus.Array([], signature="s"),
        }, signature="sv")


class TrayItem(dbus.service.Object):
    """The tray icon: every device's icon and charge, side by side.

    The image goes out as an SVG file named in IconName rather than as
    IconPixmap, because GNOME's AppIndicator extension squeezes pixmaps into a
    square but shows a wide image file at its own size."""

    HEIGHT = 16  # GNOME's panel icon size

    def __init__(self, app):
        self.conn = dbus.SessionBus(private=True)
        super().__init__(self.conn, "/StatusNotifierItem")
        self.app = app
        self.menu = Menu(self.conn, app)
        self.icon_dir = os.path.join(GLib.get_user_runtime_dir(), APP_ID)
        self.icon_file = ""
        self.serial = 0
        self.shown = None  # entries the current image shows
        self._render()
        self._watch = self.conn.watch_name_owner(SNW, self._on_watcher)

    def _on_watcher(self, owner):
        if not owner:
            return
        watcher = self.conn.get_object(SNW, "/StatusNotifierWatcher")
        watcher.RegisterStatusNotifierItem(
            self.conn.get_unique_name(), dbus_interface=SNW,
            reply_handler=lambda: None,
            error_handler=lambda e: print(f"tray: register failed: {e}", file=sys.stderr))

    def _render(self):
        """Redraw the image if what it shows changed; return whether it did."""
        a = self.app.args
        entries = []
        for dev in self.app.sorted_devices():
            color = level_color(dev.percent, a.threshold, a.critical, dev.charging)
            entries.append((ICONS.get(dev.kind, DEFAULT_ICON), dev.percent, color))
        if entries == self.shown:
            return False
        self.shown = entries
        # A fresh name every time, since the shell caches images by file.
        os.makedirs(self.icon_dir, exist_ok=True)
        self.serial += 1
        path = os.path.join(self.icon_dir, f"tray-{os.getpid()}-{self.serial}.svg")
        with open(path, "w") as f:
            f.write(render_strip(self.HEIGHT, entries))
        old, self.icon_file = self.icon_file, path
        if old:
            GLib.timeout_add_seconds(10, remove_file, old)
        return True

    def update(self):
        if self._render():
            self.NewIcon()
        self.NewTitle()
        self.NewToolTip()
        self.NewStatus(self._status())
        self.menu.refresh()

    def close(self):
        self._watch.cancel()
        self.menu.remove_from_connection()
        self.remove_from_connection()
        self.conn.close()
        remove_file(self.icon_file)

    def _status(self):
        t = self.app.args.threshold
        low = any(not d.charging and d.percent <= t for d in self.app.devices.values())
        return "NeedsAttention" if low else "Active"

    def _props(self):
        no_pixmap = dbus.Array([], signature="(iiay)")
        devices = self.app.sorted_devices()
        body = "\n".join(f"{d.kind} — {d.summary()}" for d in devices) or "No Bluetooth batteries"
        return dbus.Dictionary({
            "Category": "Hardware",
            "Id": APP_ID,
            "Title": APP_NAME,
            "Status": self._status(),
            "WindowId": dbus.Int32(0),
            "IconName": self.icon_file,
            "IconPixmap": no_pixmap,
            "AttentionIconName": self.icon_file,
            "AttentionIconPixmap": no_pixmap,
            "OverlayIconName": "",
            "OverlayIconPixmap": no_pixmap,
            "IconThemePath": "",
            "ItemIsMenu": True,
            "Menu": dbus.ObjectPath("/MenuBar"),
            "ToolTip": dbus.Struct(("", no_pixmap, APP_NAME, body), signature="sa(iiay)ss"),
        }, signature="sv")

    @dbus.service.method(PROPS, in_signature="ss", out_signature="v")
    def Get(self, iface, name):
        return self._props()[name]

    @dbus.service.method(PROPS, in_signature="s", out_signature="a{sv}")
    def GetAll(self, iface):
        return self._props() if iface == SNI else dbus.Dictionary({}, signature="sv")

    @dbus.service.method(SNI, in_signature="ii")
    def Activate(self, x, y):
        pass

    @dbus.service.method(SNI, in_signature="ii")
    def SecondaryActivate(self, x, y):
        pass

    @dbus.service.method(SNI, in_signature="ii")
    def ContextMenu(self, x, y):
        pass

    @dbus.service.method(SNI, in_signature="is")
    def Scroll(self, delta, orientation):
        pass

    @dbus.service.signal(SNI)
    def NewIcon(self):
        pass

    @dbus.service.signal(SNI)
    def NewAttentionIcon(self):
        pass

    @dbus.service.signal(SNI)
    def NewTitle(self):
        pass

    @dbus.service.signal(SNI)
    def NewToolTip(self):
        pass

    @dbus.service.signal(SNI, signature="s")
    def NewStatus(self, status):
        pass


# --------------------------------------------------------------------------
# Notifications


class Notifier:
    def __init__(self, session):
        self.session = session
        self.ids = {}  # device key -> notification id, so updates replace in place

    def _iface(self):
        obj = self.session.get_object("org.freedesktop.Notifications",
                                      "/org/freedesktop/Notifications")
        return dbus.Interface(obj, "org.freedesktop.Notifications")

    def low(self, dev, critical):
        # Same shape as GNOME's own low-battery warnings for peripherals.
        if critical:
            summary = f"{dev.kind} battery critically low"
        else:
            summary = f"{dev.kind} battery low"
        body = f"{dev.name} is low on power ({dev.percent}%)"
        hints = dbus.Dictionary({
            "urgency": dbus.Byte(2 if critical else 1),
            "category": "device",
            "desktop-entry": APP_ID,
        }, signature="sv")
        icon = "battery-empty-symbolic" if critical else "battery-caution-symbolic"
        try:
            nid = self._iface().Notify(APP_NAME, dbus.UInt32(self.ids.get(dev.key, 0)),
                                       icon, summary, body, dbus.Array([], signature="s"),
                                       hints, dbus.Int32(-1))
            self.ids[dev.key] = int(nid)
        except dbus.DBusException as e:
            print(f"notify: {e}", file=sys.stderr)

    def clear(self, key):
        nid = self.ids.pop(key, None)
        if nid:
            try:
                self._iface().CloseNotification(dbus.UInt32(nid))
            except dbus.DBusException:
                pass


# --------------------------------------------------------------------------
# Main application


class App:
    def __init__(self, args):
        self.args = args
        self.loop = GLib.MainLoop()
        self.system = dbus.SystemBus()
        self.session = dbus.SessionBus()
        self.notifier = Notifier(self.session)
        self.devices = {}  # UPower path -> Device
        self.tray = None
        self.alerted = {}  # device key -> lowest level already alerted for
        self.trends = {}  # device key -> [low, high, charging] for inference

        for sig in ("DeviceAdded", "DeviceRemoved"):
            self.system.add_signal_receiver(lambda *_: self.sync(), sig, UPOWER,
                                            UPOWER, UPOWER_PATH)
        self.system.add_signal_receiver(self._on_props, "PropertiesChanged", PROPS,
                                        UPOWER, path_keyword="path")

    def _on_props(self, iface, changed, invalidated, path=None):
        if iface == UPOWER_DEVICE and path != UPOWER_PATH:
            self.sync()

    def read_devices(self):
        upower = self.system.get_object(UPOWER, UPOWER_PATH)
        devices = {}
        for path in upower.EnumerateDevices(dbus_interface=UPOWER):
            obj = self.system.get_object(UPOWER, path)
            try:
                dev = Device(path, obj.GetAll(UPOWER_DEVICE, dbus_interface=PROPS))
            except dbus.DBusException:
                continue
            if not dev.present or not dev.is_peripheral():
                continue
            if self.args.all_peripherals or dev.is_bluetooth():
                devices[dev.path] = dev
        return devices

    def sorted_devices(self):
        return sorted(self.devices.values(), key=lambda d: (d.kind, d.name))

    def sync(self):
        try:
            self.devices = self.read_devices()
        except dbus.DBusException as e:
            print(f"upower: {e}", file=sys.stderr)
            return True
        for dev in self.devices.values():
            self.infer_charging(dev)

        if self.args.no_tray:
            pass
        elif self.tray:
            self.tray.update()
        else:
            self.tray = TrayItem(self)

        for dev in self.devices.values():
            self.check_alert(dev)
        return True  # keep the periodic timer running

    def infer_charging(self, dev):
        if dev.state_known:
            self.trends.pop(dev.key, None)
            return
        p = dev.percent
        trend = self.trends.setdefault(dev.key, [p, p, False])
        low, high, charging = trend
        if charging:
            high = max(high, p)
            if p <= high - TREND_MARGIN:
                low, charging = p, False
        else:
            low = min(low, p)
            if p >= low + TREND_MARGIN:
                high, charging = p, True
        trend[:] = [low, high, charging]
        dev.inferred_charging = charging

    def check_alert(self, dev):
        a = self.args
        if dev.charging or dev.percent >= a.threshold + REARM_MARGIN:
            if self.alerted.pop(dev.key, None) is not None:
                self.notifier.clear(dev.key)
            return
        if dev.percent > a.threshold:
            return
        level = a.critical if dev.percent <= a.critical else a.threshold
        if level < self.alerted.get(dev.key, 101):
            self.alerted[dev.key] = level
            print(f"alert: {dev.summary()}", flush=True)
            self.notifier.low(dev, critical=level == a.critical)

    def quit(self):
        self.loop.quit()
        return False

    def run(self):
        self.sync()
        GLib.timeout_add_seconds(self.args.interval, self.sync)
        for sig in (signal.SIGINT, signal.SIGTERM):
            unix_signal_add(GLib.PRIORITY_DEFAULT, sig, self.quit)
        self.loop.run()
        if self.tray:
            self.tray.close()


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("-t", "--threshold", type=int, default=40,
                   help="alert when a device is at or below this %% (default 40)")
    p.add_argument("-c", "--critical", type=int,
                   help="send a second, critical alert at or below this %% "
                        "(default half the threshold)")
    p.add_argument("-i", "--interval", type=int, default=60,
                   help="seconds between full re-reads, on top of UPower signals (default 60)")
    p.add_argument("--no-tray", action="store_true", help="notifications only, no tray icons")
    p.add_argument("--all-peripherals", action="store_true",
                   help="include non-Bluetooth peripherals (e.g. USB wireless receivers)")
    p.add_argument("-l", "--list", action="store_true", help="print battery levels and exit")
    args = p.parse_args()
    if args.critical is None:
        args.critical = args.threshold // 2
    if not 0 <= args.critical <= args.threshold <= 100:
        p.error("need 0 <= --critical <= --threshold <= 100")

    DBusGMainLoop(set_as_default=True)
    app = App(args)
    if args.list:
        devices = app.read_devices()
        for dev in sorted(devices.values(), key=lambda d: (d.kind, d.name)):
            print(f"{dev.kind:<16} {dev.summary()}")
        if not devices:
            print("no Bluetooth batteries reported by UPower")
        return
    app.run()


if __name__ == "__main__":
    main()
